DATABASE_URL=postgresql://macapagal:local-development@127.0.0.1:5432/macapagal
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-at-least-32-random-characters
TOKEN_PEPPER=replace-with-another-32-random-characters
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Macapagal Port <tickets@localhost>
NEXT_PUBLIC_API_URL=http://localhost:4000
SEAT_HOLD_TTL_SECONDS=600
BOOKING_CUTOFF_MINUTES=60
COUNTER_DEADLINE_MINUTES=120
SEAT_HOLD_EXTENSION_SECONDS=300
MAX_ACTIVE_HOLDS_PER_USER=2
MAX_ACTIVE_HOLDS_PER_IP=4
PAYMENT_PROVIDER=mock
PAYMENT_PENDING_MAX_SECONDS=900
# Optional separate secrets; if omitted, purpose-specific keys derive from TOKEN_PEPPER.
# PAYMENT_WEBHOOK_SECRET=
# DATA_ENCRYPTION_KEY=
DATA_RETENTION_DAYS=365
ENABLE_WORKERS=true
HTTP_RATE_LIMIT_MAX=600
# Optional registered social sign-in applications:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# OAUTH_CALLBACK_ORIGIN=http://localhost:4000
SMS_PROVIDER=disabled
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
