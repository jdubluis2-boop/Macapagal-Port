{
  "name": "macapagal-port",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces",
    "test": "npm run test -w apps/api",
    "db:generate": "prisma generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "test:e2e": "playwright test",
    "db:demo": "node --import tsx scripts/demo.ts",
    "staff:create": "node --import tsx scripts/create-staff.ts",
    "test:integration": "npm run test:integration -w apps/api",
    "package": "python3 scripts/package.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "6.19.0",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.9",
    "pg": "^8.16.0"
  },
  "type": "module"
}
